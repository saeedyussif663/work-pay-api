<html
  lang='en'
  xmlns='http://www.w3.org/1999/xhtml'
  xmlns:v='urn:schemas-microsoft-com:vml'
  xmlns:o='urn:schemas-microsoft-com:office:office'
>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta http-equiv='X-UA-Compatible' content='IE=edge' />
    <title>Welcome to Work &amp; Pay</title>
    <!--[if mso]>
  <noscript>
    <xml>
      <o:OfficeDocumentSettings>
        <o:PixelsPerInch>96</o:PixelsPerInch>
      </o:OfficeDocumentSettings>
    </xml>
  </noscript>
  <![endif]-->
    <style>
      body,
      table,
      td {
        -webkit-text-size-adjust: 100%;
        -ms-text-size-adjust: 100%;
      }
      table,
      td {
        mso-table-lspace: 0pt;
        mso-table-rspace: 0pt;
      }
      img {
        -ms-interpolation-mode: bicubic;
        border: 0;
        outline: none;
        text-decoration: none;
      }
      body {
        margin: 0;
        padding: 0;
        width: 100% !important;
        background-color: #efede6;
      }

      @media screen and (max-width: 600px) {
        .wp-container {
          width: 100% !important;
        }
        .wp-px {
          padding-left: 20px !important;
          padding-right: 20px !important;
        }
        .wp-h1 {
          font-size: 24px !important;
          line-height: 30px !important;
        }
      }
    </style>
  </head>
  <body style='margin:0; padding:0; background-color:#EFEDE6;'>

    <!-- Preheader (hidden preview text) -->
    <div
      style='display:none; max-height:0; overflow:hidden; mso-hide:all; font-size:1px; line-height:1px; color:#EFEDE6;'
    >
      {{name}}, your account is ready. Every payment from here gets logged,
      timestamped, and permanent.
    </div>

    <table
      role='presentation'
      width='100%'
      cellpadding='0'
      cellspacing='0'
      border='0'
      style='background-color:#EFEDE6;'
    >
      <tr>
        <td align='center' style='padding:40px 16px;'>

          <table
            role='presentation'
            class='wp-container'
            width='600'
            cellpadding='0'
            cellspacing='0'
            border='0'
            style='width:600px; max-width:600px;'
          >

            <!-- Wordmark -->
            <tr>
              <td align='left' class='wp-px' style='padding-bottom:24px;'>
                <span
                  style="font-family:'IBM Plex Mono', 'SFMono-Regular', Consolas, monospace; font-size:15px; font-weight:600; letter-spacing:0.5px; color:#171A21;"
                >
                  <span
                    style='color:#B23A2E;'
                  >[</span>&nbsp;WORK&nbsp;/&nbsp;PAY&nbsp;<span
                    style='color:#B23A2E;'
                  >]</span>
                </span>
              </td>
            </tr>

            <!-- Main card -->
            <tr>
              <td
                style='background-color:#FFFFFF; border:1px solid #D9D5C8; border-radius:14px;'
              >
                <table
                  role='presentation'
                  width='100%'
                  cellpadding='0'
                  cellspacing='0'
                  border='0'
                >

                  <!-- Stamp strip -->
                  <tr>
                    <td
                      align='right'
                      class='wp-px'
                      style='padding:24px 32px 0 32px;'
                    >
                      <span
                        style="display:inline-block; font-family:'IBM Plex Mono', Consolas, monospace; font-size:11px; font-weight:600; letter-spacing:1.5px; color:#B23A2E; border:2px solid #B23A2E; border-radius:6px; padding:5px 10px; background-color:#FBEFED;"
                      >
                        WELCOME
                      </span>
                    </td>
                  </tr>

                  <!-- Heading -->
                  <tr>
                    <td class='wp-px' style='padding:12px 32px 0 32px;'>
                      <h1
                        class='wp-h1'
                        style="margin:0; font-family:'Space Grotesk', 'Segoe UI', Helvetica, Arial, sans-serif; font-weight:700; font-size:28px; line-height:34px; letter-spacing:-0.5px; color:#171A21;"
                      >
                        Welcome,
                        {{name}}.
                      </h1>
                    </td>
                  </tr>

                  <!-- Body copy -->
                  <tr>
                    <td class='wp-px' style='padding:16px 32px 0 32px;'>
                      <p
                        style="margin:0; font-family:'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:15px; line-height:24px; color:#3A3830;"
                      >
                        Your account is ready. From here, every payment gets
                        logged the moment it's received &mdash; timestamped, and
                        permanent. No more arguing about who paid what.
                      </p>
                    </td>
                  </tr>

                  <!-- CTA -->
                  <tr>
                    <td class='wp-px' style='padding:28px 32px 0 32px;'>
                      <table
                        role='presentation'
                        cellpadding='0'
                        cellspacing='0'
                        border='0'
                      >
                        <tr>
                          <td
                            align='center'
                            bgcolor='#B23A2E'
                            style='border-radius:8px;'
                          >
                            <!--[if mso]>
                          <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="{{ctaUrl}}" style="height:44px;v-text-anchor:middle;width:200px;" arcsize="15%" fillcolor="#B23A2E" strokecolor="#B23A2E">
                          <w:anchorlock/>
                          <center style="color:#FFFFFF;font-family:sans-serif;font-size:13px;font-weight:600;letter-spacing:0.5px;">GO TO DASHBOARD</center>
                          </v:roundrect>
                          <![endif]-->
                            <!--[if !mso]><!-->
                            <a
                              href='{{ctaUrl}}'
                              target='_blank'
                              style="display:inline-block; padding:13px 28px; font-family:'IBM Plex Mono', Consolas, monospace; font-size:13px; font-weight:600; letter-spacing:0.5px; text-transform:uppercase; color:#FFFFFF; text-decoration:none; border-radius:8px;"
                            >
                              Go to dashboard &rarr;
                            </a>
                            <!--<![endif]-->
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>

                  <!-- Perforated divider -->
                  <tr>
                    <td class='wp-px' style='padding:32px 32px 0 32px;'>
                      <table
                        role='presentation'
                        width='100%'
                        cellpadding='0'
                        cellspacing='0'
                        border='0'
                      >
                        <tr>
                          <td
                            style='border-top:1px dashed #D9D5C8; font-size:1px; line-height:1px;'
                          >&nbsp;</td>
                        </tr>
                      </table>
                    </td>
                  </tr>

                  <!-- Ledger row: what happens next -->
                  <tr>
                    <td class='wp-px' style='padding:20px 32px 0 32px;'>
                      <span
                        style="font-family:'IBM Plex Mono', Consolas, monospace; font-size:11px; font-weight:600; letter-spacing:1px; text-transform:uppercase; color:#8A8779;"
                      >
                        What's next
                      </span>
                    </td>
                  </tr>
                  <tr>
                    <td class='wp-px' style='padding:10px 32px 0 32px;'>
                      <table
                        role='presentation'
                        width='100%'
                        cellpadding='0'
                        cellspacing='0'
                        border='0'
                      >
                        <tr>
                          <td
                            valign='top'
                            style="padding:6px 0; font-family:'Inter', Arial, sans-serif; font-size:14px; line-height:22px; color:#3A3830;"
                          >
                            Add your first vehicle and rider
                          </td>
                        </tr>
                        <tr>
                          <td
                            valign='top'
                            style="padding:6px 0; font-family:'Inter', Arial, sans-serif; font-size:14px; line-height:22px; color:#3A3830;"
                          >
                            Log the first payment as it comes in
                          </td>
                        </tr>
                        <tr>
                          <td
                            valign='top'
                            style="padding:6px 0 20px 0; font-family:'Inter', Arial, sans-serif; font-size:14px; line-height:22px; color:#3A3830;"
                          >
                            Watch completion track itself
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>

                </table>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                class='wp-px'
                align='center'
                style='padding:28px 32px 0 32px;'
              >
                <p
                  style="margin:0; font-family:'IBM Plex Mono', Consolas, monospace; font-size:11px; letter-spacing:0.5px; color:#8A8779;"
                >
                  Every entry, permanent.
                </p>
                <p
                  style="margin:8px 0 0 0; font-family:'Inter', Arial, sans-serif; font-size:12px; color:#A6A399;"
                >
                  Sent to
                  {{email}}
                  &middot; &copy;
                  {{year}}
                  Work &amp; Pay Tracker
                </p>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>

  </body>
</html>